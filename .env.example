# 套利参数
THRESHOLD=0.99             # 套利机会阈值(YES+NO<此值)
MIN_LIQUIDITY=10.0         # 最小流动性要求(USDC)
ESTIMATED_FEE=0.02         # 估计的交易费率(2%)
CSV_PATH=./data/opportunities.csv  # 套利机会记录路径

# Telegram 通知配置
TELEGRAM_BOT_TOKEN=your_bot_token_here        # Telegram Bot Token (从 @BotFather 获取)
TELEGRAM_CHAT_ID=your_chat_id_here            # 接收通知的 Chat ID